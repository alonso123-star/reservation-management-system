# Local development only. Copy to .env and choose your own password.
POSTGRES_DB=reservation_management
POSTGRES_USER=reservation_app
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000
# Hotel-local reception policy; no-show is allowed strictly after arrival day at this time.
HOTEL_TIME_ZONE=America/Lima
HOTEL_ARRIVAL_DEADLINE=22:00
# Generate with node scripts/setup-env.mjs (never commit the real key).
JWT_SECRET_BASE64=
